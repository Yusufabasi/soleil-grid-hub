# Soleil Grid Hub - documented environment variables (copy to .env with `make env`).
# Every value here is a local development value: `dev` credentials, compose service
# URLs or a non-secret literal. Real credentials come from the secrets manager.

# --- runtime -------------------------------------------------------------
HUB_ENV=local
HUB_VERSION=dev
# Local development key: long and varied enough to satisfy `manage.py check --deploy`
# (security.W009). Rotated from the secrets manager in every real environment.
HUB_SECRET_KEY=dev-only-local-secret-key-do-not-use-0123456789-abcdef
# 127.0.0.1 is what the local probes use and `hub` is the Host the balancer sends on its
# health checks (docs/09 1.4); both are loopback-only names.
HUB_ALLOWED_HOSTS=localhost,127.0.0.1,hub,hub-api,hub-ingest-webhooks,hub-ingest-telemetry,hub-stream
HUB_TRUST_LB_REQUEST_ID=true
HUB_DRAIN_FILE=/tmp/draining
HUB_METRICS_PORT=9102
SITE_ORIGIN=http://localhost:8080

# --- database, one connection per deployable role (docs/04 10.10) --------
HUB_DB_API_URL=postgresql+psycopg://hub_api:dev@pgbouncer:6432/hub_rw
HUB_DB_API_REPLICA_URL=postgresql+psycopg://hub_api:dev@pgbouncer:6432/hub_ro
HUB_DB_INGEST_URL=postgresql+psycopg://hub_ingest:dev@pgbouncer:6432/hub_rw
HUB_DB_WORKER_URL=postgresql+psycopg://hub_worker:dev@pgbouncer:6432/hub_rw
HUB_DB_AI_URL=postgresql+psycopg://ai_gateway:dev@pgbouncer:6432/hub_rw
HUB_MIGRATE_URL=postgresql+psycopg://migrator:dev@pg-primary:5432/hub
HUB_TEST_DB_URL=postgresql+psycopg://hub_api:dev@localhost:5432/hub_test
HUB_INGEST_ROLE=webhooks

# --- services ------------------------------------------------------------
HUB_REDIS_URL=redis://redis:6379/0
HUB_S3_ENDPOINT=http://minio:9000
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# --- payments: the collection providers and their webhook secrets --------
# Left unset on purpose. With no `HUB_PROVIDER_BASE_URLS` entry a provider uses the in-memory
# stub adapter, which verifies the same HMAC as the HTTP one and keeps collections in process
# memory: nothing leaves a laptop, and the provider whose collection a top-up names is part of
# that request, not of this file. A deployed environment sets, from its secret store and never
# from this repository:
#   HUB_PROVIDER_BASE_URLS='{"mpesa_cd": "https://provider.example/api"}'
#   HUB_PROVIDER_WEBHOOK_SECRETS='{"mpesa_cd": ["<current>", "<previous, during rotation>"]}'
# `make up` therefore runs the stub adapter for `synthetic` (the slice-T1 provider-stub service
# is still a placeholder), and `HUB_PROVIDER_WEBHOOK_SECRETS` keeps the development default.

# --- problem documents, repository root, gunicorn ------------------------
HUB_PROBLEM_BASE_URL=https://hub.soleilgrid.example/problems/
HUB_REPO_ROOT=
GUNICORN_WORKERS=4
GUNICORN_THREADS=4
GUNICORN_WORKER_CLASS=gthread

# --- local compose credentials (dev only, never reuse) -------------------
PG_OWNER_PW=dev
PG_API_PW=dev
PG_INGEST_PW=dev
PG_WORKER_PW=dev
PG_MIGRATOR_PW=dev
PG_ANALYTICS_PW=dev
# MinIO rejects a root password shorter than 8 characters, so this one is spelled out.
MINIO_ROOT_USER=dev
MINIO_ROOT_PASSWORD=dev-dev-dev
TAG=dev
