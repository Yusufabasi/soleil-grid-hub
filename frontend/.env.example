# hub-web environment (demo scope). Copy nothing: a `npm run dev` reads the repository root `.env`
# itself — the server-only two through src/lib/server-env.ts, and `make up WEB=real` passes these
# in the compose service.
#
# --- the whole NEXT_PUBLIC_ allowlist (demo-shell-plan.md §4) ----------------------------
# Three names, and never a fourth. Nothing with SECRET/KEY/TOKEN/PASSWORD in a NEXT_PUBLIC_ name
# may ever appear here: everything with that prefix is compiled into the browser bundle.
#
# The API base is a *relative* path on purpose. In `next dev` the rewrite in next.config.ts
# forwards it to the balancer; in the deployed shape the browser talks to the balancer directly
# and it routes /api/* itself. Same value, both modes, no CORS anywhere.
NEXT_PUBLIC_API_BASE=/api/v1
# Used by src/lib/format.ts for number, currency and date rendering.
NEXT_PUBLIC_DEFAULT_LOCALE=en
# The public origin of the deployment. Allowed by the same rule; the demo shell itself does not
# read it (there is no absolute-URL link and no OIDC redirect in this scope).
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:8080

# --- server only: never readable by the browser -----------------------------------------
# The provider double's control token. `docker compose` passes this to hub-web; a `next dev`
# started here picks it up from the repository root `.env`. The two sandbox route handlers in
# src/app/api/demo/ read it server-side and the value must never reach a client chunk.
STUB_CONTROL_TOKEN=dev-stub-control-token
# Where those route handlers reach the double: `http://provider-stub:9100` from inside the
# compose network, `http://localhost:9100` from a developer machine. The default is chosen from
# NODE_ENV in src/lib/sandbox.ts, so this variable is optional.
PROVIDER_STUB_BASE_URL=http://localhost:9100

# --- optional ---------------------------------------------------------------------------
# Where `next dev` forwards /api/v1 (default http://localhost:8080, the balancer).
# HUB_DEV_API_UPSTREAM=http://localhost:8080
